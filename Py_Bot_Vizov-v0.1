@app.route('/webhook', methods=['POST'])
def webhook():
    """Основной webhook для Telegram"""
    try:
        update = request.get_json()
        
        # Проверяем наличие обновления
        if not update:
            logger.warning("Получен пустой запрос")
            return jsonify({'status': 'ok'}), 200
        
        # Асинхронная обработка
        process_update(update)
        
        return jsonify({'status': 'ok'}), 200
        
    except Exception as e:
        logger.error(f"Ошибка в webhook: {e}", exc_info=True)
        return jsonify({'status': 'error', 'error': str(e)}), 500

@app.route('/set_webhook', methods=['GET'])
def set_webhook_route():
    """Установка webhook"""
    try:
        # Определяем URL для вебхука
        if WEBHOOK_URL:
            webhook_url = f"{WEBHOOK_URL}/webhook"
        else:
            # Если запускаем локально, используем ngrok или localhost
            if request.host_url and 'localhost' in request.host_url:
                return "Запустите ngrok и используйте полученный URL", 200
            webhook_url = f"{request.host_url.rstrip('/')}/webhook"
        
        logger.info(f"Попытка установить вебхук на: {webhook_url}")
        
        # Устанавливаем вебхук
        url = f"{BASE_URL}/setWebhook"
        payload = {
            'url': webhook_url,
            'drop_pending_updates': True,
            'allowed_updates': ['message', 'callback_query']
        }
        
        response = requests.post(url, json=payload, timeout=10)
        result = response.json()
        
        logger.info(f"Результат установки вебхука: {result}")
        
        if result.get('ok'):
            # Отправляем тестовое сообщение администратору
            try:
                test_message = f"✅ Вебхук установлен!\nURL: {webhook_url}\nБот готов к работе!"
                send_message(ADMIN_ID, test_message)
            except:
                logger.warning("Не удалось отправить тестовое сообщение")
            
            return jsonify({
                'status': 'success',
                'message': f'✅ Webhook установлен: {webhook_url}',
                'result': result
            })
        else:
            error_msg = result.get('description', 'Неизвестная ошибка')
            return jsonify({
                'status': 'error',
                'message': f'❌ Ошибка: {error_msg}',
                'result': result
            })
            
    except Exception as e:
        logger.error(f"Ошибка установки вебхука: {e}")
        return jsonify({'status': 'error', 'error': str(e)}), 500

@app.route('/delete_webhook', methods=['GET'])
def delete_webhook_route():
    """Удаление webhook"""
    try:
        url = f"{BASE_URL}/deleteWebhook"
        response = requests.post(url, timeout=10)
        result = response.json()
        
        if result.get('ok'):
            return jsonify({'status': 'success', 'message': '✅ Webhook удален'})
        else:
            return jsonify({'status': 'error', 'message': f'❌ Ошибка: {result.get("description")}'})
    except Exception as e:
        return jsonify({'status': 'error', 'error': str(e)}), 500

