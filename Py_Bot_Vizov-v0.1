def initialize_bot():
    """Инициализация бота при запуске"""
    logger.info("=" * 60)
    logger.info("🚀 ИНИЦИАЛИЗАЦИЯ БОТА 'ВЫЗОВ!'")
    logger.info("=" * 60)
    
    # Проверяем токен
    if not TOKEN or TOKEN == "YOUR_BOT_TOKEN_HERE":
        logger.error("❌ ТОКЕН БОТА НЕ НАСТРОЕН!")
        logger.error("Пожалуйста, установите правильный токен бота.")
        return False
    
    # Проверяем подключение к Telegram API
    try:
        url = f"{BASE_URL}/getMe"
        response = requests.get(url, timeout=10)
        result = response.json()
        
        if result.get('ok'):
            bot_name = result['result']['first_name']
            bot_username = result['result'].get('username', 'нет')
            
            logger.info(f"✅ БОТ ПОДКЛЮЧЕН: {bot_name} (@{bot_username})")
            logger.info(f"📊 ID администратора: {ADMIN_ID}")
            
            # Проверяем текущий вебхук
            webhook_info = requests.get(f"{BASE_URL}/getWebhookInfo", timeout=10).json()
            if webhook_info.get('ok'):
                current_url = webhook_info['result'].get('url', 'не установлен')
                logger.info(f"🌐 Текущий вебхук: {current_url}")
            
            return True
        else:
            logger.error(f"❌ ОШИБКА ПОДКЛЮЧЕНИЯ К БОТУ: {result.get('description')}")
            logger.error("Проверьте:")
            logger.error("1. Правильность токена")
            logger.error("2. Доступность интернета")
            logger.error("3. Что бот активирован через @BotFather")
            return False
            
    except Exception as e:
        logger.error(f"❌ ОШИБКА ПРИ ПОДКЛЮЧЕНИИ К TELEGRAM API: {e}")
        return False

if __name__ == '__main__':
    # Инициализируем бота
    if initialize_bot():
        port = int(os.getenv('PORT', 8080))
        host = '0.0.0.0'
        
        logger.info(f"🌐 Запуск веб-сервера на {host}:{port}")
        logger.info(f"📞 Webhook URL: {WEBHOOK_URL}/webhook" if WEBHOOK_URL else "📞 Webhook URL: будет определен при запуске")
        logger.info("=" * 60)
        logger.info("✅ Бот готов к работе!")
        logger.info("=" * 60)
        
        # Запускаем Flask приложение
        app.run(
            host=host,
            port=port,
            debug=False,
            threaded=True
        )
    else:
        logger.error("❌ Не удалось инициализировать бота. Приложение завершено.")
        sys.exit(1)
