def process_update(update):
    """Обработка входящего обновления от Telegram"""
    try:
        # Логируем полученное обновление
        logger.info(f"Получено обновление: {json.dumps(update, ensure_ascii=False)[:500]}...")
        
        # Обработка callback query (inline кнопки)
        if 'callback_query' in update:
            callback_query = update['callback_query']
            user_id = callback_query['from']['id']
            chat_id = callback_query['message']['chat']['id']
            message_id = callback_query['message']['message_id']
            callback_id = callback_query['id']
            data = callback_query['data']
            
            logger.info(f"Callback от {user_id}: {data}")
            
            if data == 'throw_dice':
                throw_dice_callback(chat_id, message_id, user_id, callback_id)
            elif data == 'reformulate':
                reformulate_callback(chat_id, user_id, callback_id)
            elif data == 'go_to_stage3':
                go_to_stage3_callback(chat_id, user_id, callback_id)
            elif data.startswith('shape_'):
                handle_shape_selection(chat_id, user_id, data, callback_id)
            
            return
        
        # Обработка обычного сообщения
        if 'message' not in update:
            return
            
        message = update['message']
        chat_id = message['chat']['id']
        user_id = message['from']['id']
        first_name = message['from'].get('first_name', 'Пользователь')
        text = message.get('text', '').strip()
        
        logger.info(f"Сообщение от {user_id} ({first_name}): {text}")
        
        # Инициализация пользователя
        if user_id not in user_states:
            user_states[user_id] = START
        if user_id not in user_data:
            user_data[user_id] = {}
        
        current_state = user_states.get(user_id, START)
        
        # Обработка команд
        if text.startswith('/start'):
            start_command(chat_id, user_id, first_name)
            return
        
        # Обработка кнопок главного меню
        if text == '🎯 НАЧАТЬ ИГРУ' and current_state == START:
            begin_game(chat_id, user_id)
            return
        elif text == '🆘 Помощь':
            help_command(chat_id)
            return
        elif text == '👤 Мой ID':
            my_id_command(chat_id, user_id, first_name)
            return
        elif text == '↩️ В главное меню':
            start_command(chat_id, user_id, first_name)
            return
        
        # Обработка кнопки Назад
        elif text == '⬅️ Назад':
            if current_state > START:
                user_states[user_id] = current_state - 1
                if current_state == STAGE1:
                    start_command(chat_id, user_id, first_name)
                elif current_state == STAGE2:
                    begin_game(chat_id, user_id)
                elif current_state == STAGE3:
                    # Вернуться к броску кубика
                    user_states[user_id] = STAGE2
                    send_message(chat_id, "Возвращаемся к этапу 2...", reply_markup=get_stage2_keyboard())
            else:
                start_command(chat_id, user_id, first_name)
            return
        
        # Обработка кнопки Далее
        elif text == '➡️ Далее' and current_state == STAGE1:
            if 'request' in user_data[user_id]:
                handle_stage1_response(chat_id, user_id, user_data[user_id]['request'])
            else:
                send_message(chat_id, "Сначала напишите свой запрос.")
            return
        
        # Обработка этапа 1 (ввод запроса)
        elif current_state == STAGE1 and text not in ['⬅️ Назад', '➡️ Далее', '🆘 Помощь', '👤 Мой ID']:
            handle_stage1_response(chat_id, user_id, text)
            return
        
        # Обработка кнопок этапа 2
        elif text == '🎲 Бросить кубик' and current_state == STAGE2:
            keyboard = create_inline_keyboard([
                [{'text': '🎲 Бросить кубик', 'callback_data': 'throw_dice'}]
            ])
            send_message(chat_id, "Нажмите кнопку чтобы бросить кубик:", reply_markup=keyboard)
            return
        
        # Обработка кнопок этапа 3
        elif text == '🔘 Выбрать фигуры' and current_state == STAGE3:
            go_to_stage3_callback(chat_id, user_id, None)
            return
        
        # Обработка кнопок этапа 4
        elif current_state == STAGE4:
            if text == '🎴 Вытянуть карту':
                draw_card(chat_id, user_id)
                return
            elif text == '🪜 К Лестнице Успеха':
                go_to_stage5(chat_id, user_id)
                return
        
        # Обработка кнопок этапа 5
        elif current_state == STAGE5:
            if text == '🏁 Завершить игру':
                complete_game(chat_id, user_id)
                return
            elif text == '🎴 Вытянуть карту':
                draw_card(chat_id, user_id)
                return
            elif text == '🎲 Бросить кубик':
                dice_roll = random.randint(1, 6)
                send_message(chat_id, f"🎲 Выпало: {dice_roll}")
                return
        
        # Если сообщение не обработано, показываем подсказку
        if text:
            if current_state == START:
                send_message(chat_id, "Используйте кнопки меню для навигации.", reply_markup=get_main_menu_keyboard())
            elif current_state == STAGE1:
                send_message(chat_id, "Напишите ваш запрос или используйте кнопки навигации.", reply_markup=get_stage1_keyboard())
            
    except Exception as e:
        logger.error(f"Ошибка обработки обновления: {e}", exc_info=True)

