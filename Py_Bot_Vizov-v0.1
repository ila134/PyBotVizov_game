def handle_shape_selection(chat_id, user_id, shape_name, callback_id):
    """Обработка выбора фигуры"""
    if 'shapes' not in user_data[user_id]:
        user_data[user_id]['shapes'] = []
    
    user_data[user_id]['shapes'].append(shape_name)
    selected_count = len(user_data[user_id]['shapes'])
    
    shape_display_names = {
        'shape_square': '🔷 Квадрат',
        'shape_triangle': '🔺 Треугольник', 
        'shape_circle': '⚪ Круг',
        'shape_zigzag': '🌀 Зигзаг',
        'shape_rectangle': '🔶 Прямоугольник'
    }
    
    display_name = shape_display_names.get(shape_name, shape_name)
    
    if selected_count == 1:
        answer_callback_query(callback_id, f"Выбрана первая фигура: {display_name}")
        
        # Показываем оставшиеся фигуры для второго выбора
        remaining_shapes = [
            ('🔷 Квадрат', 'shape_square'),
            ('🔺 Треугольник', 'shape_triangle'),
            ('⚪ Круг', 'shape_circle'),
            ('🌀 Зигзаг', 'shape_zigzag'),
            ('🔶 Прямоугольник', 'shape_rectangle')
        ]
        
        # Убираем уже выбранную фигуру
        remaining_shapes = [s for s in remaining_shapes if s[1] != shape_name]
        
        keyboard_buttons = []
        for display, callback_data in remaining_shapes:
            keyboard_buttons.append([{'text': display, 'callback_data': callback_data}])
        
        keyboard = create_inline_keyboard(keyboard_buttons)
        send_message(chat_id, "Отлично! Теперь выберите вторую фигуру:", reply_markup=keyboard)
        
    elif selected_count == 2:
        answer_callback_query(callback_id, f"Выбрана вторая фигура: {display_name}")
        
        # Завершаем этап 3
        final_text = """✨ <b>Отлично! Этап психогеометрии завершен.</b>

<b>Ваши выбранные фигуры:</b>"""
        
        for shape_callback in user_data[user_id]['shapes']:
            shape_name = shape_display_names.get(shape_callback, shape_callback)
            final_text += f"\n• {shape_name}"
        
        final_text += "\n\nКаждая фигура отражает ваши сильные стороны и потенциал для развития."
        
        send_message(chat_id, final_text)
        
        # Переход к следующему этапу
        time.sleep(2)
        go_to_stage4(chat_id, user_id)

