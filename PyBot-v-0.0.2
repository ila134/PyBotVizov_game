def get_stage5_ladder_keyboard(step_number):
    """Клавиатура для Лестницы Успеха БЕЗ дублирования"""
    if step_number >= len(LADDER_OF_SUCCESS):
        step_number = len(LADDER_OF_SUCCESS) - 1
    
    current_step = LADDER_OF_SUCCESS[step_number]
    buttons = []
    
    # Опции текущей ступени
    for option in current_step["options"]:
        buttons.append([option])
    
    # Навигационные кнопки
    nav_buttons = []
    if step_number > 0:
        nav_buttons.append('⬅️ Предыдущая ступень')
    if step_number < len(LADDER_OF_SUCCESS) - 1:
        nav_buttons.append('➡️ Следующая ступень')
    
    if nav_buttons:
        buttons.append(nav_buttons)
    
    # Универсальные действия
    buttons.append(['🎴 Вытянуть карту'])
    
    # Универсальная навигация
    buttons.extend(get_universal_navigation_buttons())
    
    return create_reply_keyboard(buttons)

