    user_data[user_id]['case_question'] = 0
    
    case_text = f"""📚 <b>Кейс: {case['title']}</b>

{case['description']}

<b>Вопрос для размышления:</b>
{case['questions'][0]}"""
    
    send_message(chat_id, case_text, parse_mode='HTML', reply_markup=get_stage5_case_keyboard())

def handle_case_study(chat_id, user_id, text):
    """Обработка работы с кейсом"""
    if text == '📝 Ответить на вопросы кейса':
        case = user_data[user_id].get('current_case')
        question_index = user_data[user_id].get('case_question', 0)
        send_message(chat_id, f"💭 Ответьте на вопрос: {case['questions'][question_index]}\n\nНапишите ваш ответ текстом.")
    elif text == '🔘 Следующий вопрос':
        case = user_data[user_id].get('current_case')
        question_index = user_data[user_id].get('case_question', 0) + 1
        
        if question_index < len(case['questions']):
            user_data[user_id]['case_question'] = question_index
            send_message(chat_id, f"➡️ <b>Следующий вопрос:</b>\n\n{case['questions'][question_index]}", 
                         parse_mode='HTML', reply_markup=get_stage5_case_keyboard())
        else:
            send_message(chat_id, "✅ Все вопросы кейса пройдены! Возвращаемся к Лестнице Успеха.")
            user_states[user_id] = STAGE5_LADDER
            show_current_step(chat_id, user_id)
    elif text == '⬅️ Назад к ступеням':
        user_states[user_id] = STAGE5_LADDER
        show_current_step(chat_id, user_id)
    elif text == '🎴 Вытянуть карту для подсказки':
        draw_metaphorical_card(chat_id, user_id)
    elif text == '↩️ В главное меню':
        go_to_main_menu(chat_id, user_id)

