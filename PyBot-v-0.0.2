# Функции для работы с кодами доступа
def generate_access_code(length=8, expires_hours=24):
    """Генерация кода доступа"""
    code = ''.join(random.choices('ABCDEFGHJKLMNPQRSTUVWXYZ23456789', k=length))
    expires_at = datetime.now() + timedelta(hours=expires_hours)
    return code, expires_at

def save_access_code(code, expires_at, max_uses=1):
    """Сохранение кода доступа"""
    access_codes[code] = {
        'created_at': datetime.now(),
        'expires_at': expires_at,
        'max_uses': max_uses,
        'used_count': 0,
        'used_by': []
    }
    return code

def is_access_code_valid(code):
    """Проверка валидности кода доступа"""
    if code not in access_codes:
        return False

    code_data = access_codes[code]
    if datetime.now() > code_data['expires_at']:
        del access_codes[code]
        return False

    if code_data['used_count'] >= code_data['max_uses']:
        return False

    return True

def use_access_code(code, user_id):
    """Использование кода доступа"""
    if not is_access_code_valid(code):
        return False

    access_codes[code]['used_count'] += 1
    access_codes[code]['used_by'].append({
        'user_id': user_id,
        'used_at': datetime.now()
    })
    return True

