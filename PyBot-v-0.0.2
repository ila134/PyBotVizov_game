# Основная функция обработки сообщений
def process_update(update):
    try:
        logger.info(f"Получено обновление: {update}")
        
        if 'message' in update:
            message = update['message']
            chat_id = message['chat']['id']
            user_id = message['from']['id']
            first_name = message['from'].get('first_name', 'Пользователь')
            username = message['from'].get('username', '')

            is_admin = (user_id == ADMIN_ID)
            text = message.get('text', '').strip()

            if user_id not in user_states:
                user_states[user_id] = START
            if user_id not in user_data:
                user_data[user_id] = {}

            # Определяем текущее состояние
            current_state = user_states.get(user_id, START)
            
            # Обработка навигации по Лестнице Успеха (универсальные кнопки обрабатываются здесь)
            if current_state == STAGE5_LADDER:
                handle_ladder_navigation(chat_id, user_id, text)
                return
            elif current_state == STAGE5_CASE:
                handle_case_study(chat_id, user_id, text)
                return

            # Административные команды
            if is_admin and text == '/admin':
                admin_menu(chat_id, user_id)
                return

            if is_admin and current_state in [ADMIN_MENU, ADMIN_CREATE_CODE, ADMIN_VIEW_CODES]:
                if text == '🔑 Создать код доступа':
                    admin_create_code(chat_id, user_id)
                elif text == '📋 Просмотреть коды':
                    admin_view_codes(chat_id, user_id)
                elif text == '⬅️ В главное меню':
                    go_to_main_menu(chat_id, user_id)
                return

            # Обработка команды /start
            if text.startswith('/start'):
                parts = text.split()
                access_code = parts[1] if len(parts) > 1 else None
                start(chat_id, user_id, first_name, access_code)
                return

            # Обработка основных этапов игры
            if current_state == START and text == '🎯 НАЧАТЬ ИГРУ':
                stage_intro(chat_id, user_id)
            elif current_state == STAGE1:
                stage1_get_request(chat_id, user_id, text)
            elif current_state == STAGE2_REFORMULATE:
                stage2_get_reformulation(chat_id, user_id, text)
            elif current_state == STAGE4_CARDS:
                if text == '🎴 Вытянуть карту':
                    draw_metaphorical_card(chat_id, user_id)
                elif text == '🤔 Помощь в интерпретации':
                    interpret_card(chat_id, user_id)
                elif text == '🪜 К Лестнице Успеха':
                    stage5_intro(chat_id, user_id)
                elif text == '⬅️ Назад':
                    go_back(chat_id, user_id)
                else:
                    send_message(chat_id, "Используйте кнопки для навигации.", reply_markup=get_stage4_keyboard())

        elif 'callback_query' in update:
            # Обработка inline-кнопок (кубик, фигуры и т.д.)
            callback_query = update['callback_query']
            message = callback_query['message']
            chat_id = message['chat']['id']
            message_id = message['message_id']
            user_id = callback_query['from']['id']
            callback_query_id = callback_query['id']
            data = callback_query['data']
            
            if data == 'throw_dice':
                stage2_throw_dice(chat_id, message_id, user_id, callback_query_id)
            elif data == 'reformulate':
                stage2_reformulate(chat_id, message_id, user_id, callback_query_id)
            elif data == 'next_stage':
                stage2_next(chat_id, message_id, user_id, callback_query_id)
            elif data == 'ready_for_shapes':
                stage3_show_shapes(chat_id, message_id, user_id, callback_query_id)
            elif data.startswith('shape_'):
                shape_key = data.replace('shape_', '')
                current_state = user_states.get(user_id, START)
                if current_state == STAGE3_FIRST_CHOICE:
                    stage3_first_choice(chat_id, message_id, user_id, shape_key, callback_query_id)
                elif current_state == STAGE3_SECOND_CHOICE:
                    stage3_second_choice(chat_id, message_id, user_id, shape_key, callback_query_id)
            else:
                answer_callback_query(callback_query_id, "Действие недоступно")
                
    except Exception as e:
        logger.error(f"Error processing update: {e}")
        logger.error(f"Update content: {update}")

# Проверка подключения
def test_bot_connection():
    logger.info("Тестирование подключения к боту...")
    url = f"{BASE_URL}/getMe"
    try:
        response = requests.get(url, timeout=10)
        result = response.json()
        if result.get('ok'):
            logger.info("✅ Бот подключен успешно!")
            logger.info(f"Имя бота: {result['result']['first_name']}")
            return True
        else:
            logger.error("❌ Ошибка подключения к боту")
            logger.error(f"Описание ошибки: {result.get('description')}")
            return False
    except Exception as e:
        logger.error(f"❌ Ошибка при тестировании подключения: {e}")
        return False

# Проверка файлов
def check_required_files():
    logger.info("Проверка необходимых файлов...")
    missing_files = []
    
    # Проверяем файлы психогеометрии
    for shape, filename in SHAPE_DESCRIPTION_FILES.items():
        if not os.path.exists(filename):
            missing_files.append(filename)
            logger.warning(f"Файл не найден: {filename}")
    
    # Проверяем файлы карт
    for i in range(1, 53):
        card_file = f"/home/Algoritek/images/метафорические карты вызов-изображения-{i}.jpg"
        if not os.path.exists(card_file):
            missing_files.append(card_file)
            logger.warning(f"Файл не найден: {card_file}")
    
    if missing_files:
        logger.error(f"❌ Отсутствуют файлы: {len(missing_files)}")
        return False
    else:
        logger.info("✅ Все файлы на месте")
        return True

# Основная функция
def main():
    # Регистрируем обработчики сигналов
    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)
    
    logger.info("=" * 50)
    logger.info("Запуск бота...")
    logger.info(f"Токен бота: {TOKEN[:10]}...{TOKEN[-5:]}")
    logger.info(f"ID администратора: {ADMIN_ID}")
    logger.info("=" * 50)

    # Проверяем подключение
    if not test_bot_connection():
        logger.error("Не удалось подключиться к боту. Завершаем работу.")
        return

    # Проверяем файлы
    if not check_required_files():
        logger.warning("Некоторые файлы отсутствуют, но продолжаем работу...")

    offset = 0
    max_iterations = 100
    processed_updates = 0
    
    logger.info("Бот готов к работе. Ожидание сообщений...")
    
    for iteration in range(max_iterations):
        try:
            url = f"{BASE_URL}/getUpdates?offset={offset}&timeout=10"
            response = requests.get(url, timeout=15)
            updates = response.json()

            if updates.get('ok'):
                if updates['result']:
                    logger.info(f"Получено {len(updates['result'])} обновлений")
                    for update in updates['result']:
                        offset = update['update_id'] + 1
                        process_update(update)
                        processed_updates += 1
                else:
                    if iteration % 10 == 0:
                        logger.info(f"Итерация {iteration+1}: нет новых сообщений")
            else:
                logger.error(f"Ошибка API Telegram: {updates}")

        except requests.exceptions.Timeout:
            logger.debug("Таймаут запроса, продолжаем...")
        except Exception as e:
            logger.error(f"Ошибка в основном цикле: {e}")
        
        time.sleep(0.5)
    
    logger.info(f"Завершение работы. Обработано сообщений: {processed_updates}")

if __name__ == '__main__':
    main()
