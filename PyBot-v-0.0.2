def handle_ladder_navigation(chat_id, user_id, text):
    """Обработка навигации по Лестнице Успеха"""
    if user_id not in user_data:
        user_data[user_id] = {}
    
    current_step = user_data[user_id].get(CURRENT_STEP, 0)
    
    # Навигация между ступенями
    if text == '➡️ Следующая ступень':
        if current_step < len(LADDER_OF_SUCCESS) - 1:
            user_data[user_id][CURRENT_STEP] = current_step + 1
            show_current_step(chat_id, user_id)
        else:
            send_message(chat_id, "🎉 Поздравляем! Вы достигли вершины Лестницы!", 
                         reply_markup=get_stage5_ladder_keyboard(current_step))
    elif text == '⬅️ Предыдущая ступень':
        if current_step > 0:
            user_data[user_id][CURRENT_STEP] = current_step - 1
            show_current_step(chat_id, user_id)
        else:
            send_message(chat_id, "Это первая ступень Лестницы.", 
                         reply_markup=get_stage5_ladder_keyboard(current_step))
    
    # Опции ступеней
    elif text == '🔘 Иду дальше':
        if current_step < len(LADDER_OF_SUCCESS) - 1:
            user_data[user_id][CURRENT_STEP] = current_step + 1
            show_current_step(chat_id, user_id)
        else:
            complete_game(chat_id, user_id)
    elif '🔘 Хочу метафорическую карту' in text or '🔘 Взять метафорическую карту' in text or '🔘 Взять метафоричную карту' in text:
        draw_metaphorical_card(chat_id, user_id)
    elif '🔘 Бросить кубик' in text:
        dice_roll = random.randint(1, 6)
        send_message(chat_id, f"🎲 Выпало: {dice_roll}\n\nИнтересно! Это число может быть подсказкой для размышлений.", 
                     reply_markup=get_stage5_ladder_keyboard(current_step))
        draw_metaphorical_card(chat_id, user_id)
    elif text == '🔘 Вытянуть кейс':
        start_case_study(chat_id, user_id)
    elif '🔘 Вытянуть таблетки от самосаботажа' in text:
        send_message(chat_id, "💊 <b>Таблетки от самосаботажа:</b>\n\n1. Осознанность\n2. Маленькие шаги\n3. Самоподдержка\n4. Отслеживание прогресса\n5. Празднование успехов", 
                     parse_mode='HTML', reply_markup=get_stage5_ladder_keyboard(current_step))
    elif '🔘 Вытянуть полезные навыки' in text:
        send_message(chat_id, "🛠️ <b>Полезные навыки и привычки:</b>\n\n1. Тайм-менеджмент\n2. Эмоциональный интеллект\n3. Навык делегирования", 
                     parse_mode='HTML', reply_markup=get_stage5_ladder_keyboard(current_step))
    elif text == '🔘 Хочу сохранить свой путь':
        save_user_journey(chat_id, user_id)
    elif text == '🔘 Хочу оставить отзыв':
        request_feedback(chat_id, user_id)
    elif text == '🏁 Завершить игру':
        complete_game(chat_id, user_id)
    elif text == '🎴 Вытянуть карту':
        draw_metaphorical_card(chat_id, user_id)
    elif text == '🆘 Помощь':
        show_help(chat_id, user_id)
    elif text == '👤 Мой ID':
        show_my_id(chat_id, user_id, "Пользователь", "")
    elif text == '↩️ В главное меню':
