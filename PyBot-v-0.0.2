        reply_markup = get_stage1_keyboard()
    else:
        reply_markup = get_main_menu_keyboard()
    
    send_message(chat_id, user_info, parse_mode='HTML', reply_markup=reply_markup)

def go_to_main_menu(chat_id, user_id):
    """Возврат в главное меню"""
    user_states[user_id] = START
    user_data[user_id] = {}
    send_message(chat_id, "Возвращаемся в главное меню...", reply_markup=get_main_menu_keyboard())

def go_back(chat_id, user_id):
    """Обработка кнопки Назад"""
    current_state = user_states.get(user_id, START)
    
    if current_state == STAGE1:
        user_states[user_id] = START
        send_message(chat_id, "Возвращаемся в главное меню...", reply_markup=get_main_menu_keyboard())
    elif current_state in [STAGE2_DICE, STAGE2, STAGE2_REFORMULATE]:
        user_states[user_id] = STAGE1
        stage_intro(chat_id, user_id)
    elif current_state in [STAGE3_FIRST_CHOICE, STAGE3_SECOND_CHOICE]:
        user_states[user_id] = STAGE2
        send_message(chat_id, "Возвращаемся к этапу 2...", reply_markup=get_stage2_keyboard())
    elif current_state == STAGE4_CARDS:
        user_states[user_id] = STAGE3_FIRST_CHOICE
        send_message(chat_id, "Возвращаемся к этапу 3...", reply_markup=get_stage3_keyboard())
    elif current_state == STAGE5_LADDER:
        user_states[user_id] = STAGE4_CARDS
        stage4_intro(chat_id, user_id)
    elif current_state == STAGE5_CASE:
        user_states[user_id] = STAGE5_LADDER
        show_current_step(chat_id, user_id)
    else:
        go_to_main_menu(chat_id, user_id)

# Функции работы с Telegram API
def send_photo(chat_id, photo_path, caption=None, reply_markup=None):
    url = f"{BASE_URL}/sendPhoto"
    if photo_path.startswith('AgAC'):
        payload = {'chat_id': chat_id, 'photo': photo_path}
        if caption: payload['caption'] = caption
        if reply_markup: payload['reply_markup'] = json.dumps(reply_markup)
        try:
            return requests.post(url, json=payload, timeout=10).json()
        except Exception as e:
            logger.error(f"Error sending photo by file_id: {e}")
            return None
    else:
        try:
            with open(photo_path, 'rb') as photo_file:
                files = {'photo': photo_file}
                payload = {'chat_id': chat_id}
                if caption: payload['caption'] = caption
                if reply_markup: payload['reply_markup'] = json.dumps(reply_markup)
                return requests.post(url, data=payload, files=files, timeout=10).json()
        except FileNotFoundError:
            logger.error(f"File not found: {photo_path}")
            send_message(chat_id, "⚠️ Изображение временно недоступно")
            return None
        except Exception as e:
            logger.error(f"Error sending photo file: {e}")
            return None

def send_message(chat_id, text, reply_markup=None, parse_mode=None):
    url = f"{BASE_URL}/sendMessage"
    payload = {'chat_id': chat_id, 'text': text}
    if parse_mode: payload['parse_mode'] = parse_mode
    if reply_markup: payload['reply_markup'] = json.dumps(reply_markup)
    try:
        return requests.post(url, json=payload, timeout=10).json()
    except Exception as e:
        logger.error(f"Error sending message: {e}")
        return None

def edit_message_text(chat_id, message_id, text, reply_markup=None, parse_mode=None):
    url = f"{BASE_URL}/editMessageText"
    payload = {'chat_id': chat_id, 'message_id': message_id, 'text': text}
    if parse_mode: payload['parse_mode'] = parse_mode
    if reply_markup: payload['reply_markup'] = json.dumps(reply_markup)
    try:
        return requests.post(url, json=payload, timeout=10).json()
    except Exception as e:
        logger.error(f"Error editing message: {e}")
        return None

def answer_callback_query(callback_query_id, text=None):
    url = f"{BASE_URL}/answerCallbackQuery"
    payload = {'callback_query_id': callback_query_id}
    if text: payload['text'] = text
    try:
        return requests.post(url, json=payload, timeout=10).json()
    except Exception as e:
        logger.error(f"Error answering callback: {e}")
        return None

def delete_message(chat_id, message_id):
    url = f"{BASE_URL}/deleteMessage"
    payload = {'chat_id': chat_id, 'message_id': message_id}
    try:
        return requests.post(url, json=payload, timeout=10).json()
    except Exception as e:
        logger.error(f"Error deleting message: {e}")
        return None

