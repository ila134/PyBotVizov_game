    else:
        # Текстовый ответ на задание
        handle_text_response(chat_id, user_id, text)

def handle_text_response(chat_id, user_id, text):
    """Обработка текстовых ответов пользователя на задания"""
    current_state = user_states.get(user_id, START)
    current_step = user_data.get(user_id, {}).get(CURRENT_STEP, 0)
    
    if current_state == STAGE5_LADDER:
        # Сохраняем ответ пользователя
        if 'user_answers' not in user_data[user_id]:
            user_data[user_id]['user_answers'] = {}
        user_data[user_id]['user_answers'][current_step] = text
        
        send_message(chat_id, f"✅ Ответ на ступень {current_step + 1} сохранен! Можете продолжить работу со ступенью.", 
                     reply_markup=get_stage5_ladder_keyboard(current_step))
    elif current_state == STAGE5_CASE:
        # Обработка ответов на кейсы
        if 'case_answers' not in user_data[user_id]:
            user_data[user_id]['case_answers'] = []
        user_data[user_id]['case_answers'].append(text)
        send_message(chat_id, "✅ Ответ на вопрос кейса сохранен! Продолжайте.", 
                     reply_markup=get_stage5_case_keyboard())

def start_case_study(chat_id, user_id):
